{
    "name": "laboiteacode/monitor-wordpress",
    "description": "WordPress plugin to report PHP errors, exceptions and fatal shutdowns to a Quiet Guard server.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "monitoring",
        "error-tracking",
        "exceptions",
        "logging"
    ],
    "authors": [
        {
            "name": "Alexandre Ribes",
            "email": "alexandre@laboiteacode.fr",
            "homepage": "https://laboiteacode.fr"
        }
    ],
    "homepage": "https://github.com/Quiet-Guard/monitor-wordpress",
    "support": {
        "issues": "https://github.com/Quiet-Guard/monitor-wordpress/issues",
        "source": "https://github.com/Quiet-Guard/monitor-wordpress"
    },
    "require": {
        "php": "^8.2",
        "laboiteacode/monitor-php": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\Monitor\\WordPress\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/monitor-php",
            "options": {
                "versions": {
                    "laboiteacode/monitor-php": "0.1.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
